  <!-- ==========================================================
       JAVASCRIPT RINGAN & PRAKTIS
       ========================================================== -->
  <script>
    // 1. Pengatur Ukuran Huruf (Aksesibilitas bagi Orang Tua)
    const btnFont = document.getElementById('btnToggleFont');
    let isBigFont = false;

    btnFont.addEventListener('click', function() {
      isBigFont = !isBigFont;
      document.body.classList.toggle('teks-besar', isBigFont);
      if (isBigFont) {
        btnFont.innerHTML = '<span>🔍</span> <strong>Ukuran Normal</strong>';
      } else {
        btnFont.innerHTML = '<span>🔍</span> <strong>Perbesar Tulisan</strong>';
      }
    });

    // 2. Accordion FAQ
    function toggleFaq(btn) {
      const card = btn.parentElement;
      const isOpen = card.classList.contains('terbuka');

      document.querySelectorAll('.faq-item-modern').forEach(el => el.classList.remove('terbuka'));

      if (!isOpen) {
        card.classList.add('terbuka');
      }
    }

    // 3. Filter Kategori Tutor
    function filterKategori(kat, btn) {
      document.querySelectorAll('.filter-btn-pill').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      const cards = document.querySelectorAll('.tutor-card-clean');
      cards.forEach(card => {
        const p = card.getAttribute('data-pelajaran');
        if (kat === 'semua' || p === kat) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    }

    // 4. Pencarian Cepat
    function lakukanPencarian() {
      const mapel = document.getElementById('pilihanMataPelajaran').value;
      const cards = document.querySelectorAll('.tutor-card-clean');
      let count = 0;

      cards.forEach(card => {
        const p = card.getAttribute('data-pelajaran');
        if (mapel === 'semua' || mapel === 'pr' || p === mapel) {
          card.style.display = 'flex';
          count++;
        } else {
          card.style.display = 'none';
        }
      });

      document.querySelectorAll('.filter-btn-pill').forEach(b => {
        if (b.getAttribute('data-kat') === mapel) {
          b.classList.add('active');
        } else {
          b.classList.remove('active');
        }
      });

      document.getElementById('tutor-berpengalaman').scrollIntoView({ behavior: 'smooth' });
      tampilkanToast(`Menemukan ${count} tutor berpengalaman yang siap membantu!`);
    }

    // 5. Modal Pemesanan Sesi Gratis
    const modalBox = document.getElementById('modalBookingBox');
    const inputTutor = document.getElementById('inputTutorDipilih');

    function bukaModal(nama, mapel) {
      inputTutor.value = `${nama} - ${mapel}`;
      modalBox.classList.add('aktif');
      document.body.style.overflow = 'hidden';
    }

    function tutupModal() {
      modalBox.classList.remove('aktif');
      document.body.style.overflow = '';
    }

    function tutupJikaKlikLuar(e) {
      if (e.target === modalBox) {
        tutupModal();
      }
    }

    function prosesBooking() {
      const nama = document.getElementById('inputNamaSiswa').value;
      tutupModal();
      tampilkanToast(`Terima kasih! Jadwal uji coba gratis untuk ananda ${nama} telah tercatat. Kami akan mengirimkan detail via WhatsApp.`);
      document.getElementById('inputNamaSiswa').value = '';
      document.getElementById('inputTeleponOrtu').value = '';
      document.getElementById('inputJadwal').value = '';
    }

    // 6. Form Callback
    function kirimCallback() {
      const tel = document.getElementById('inputTelCallback').value;
      tampilkanToast(`Permintaan terkirim! Tim kami akan menelepon nomor ${tel} sebentar lagi.`);
      document.getElementById('inputTelCallback').value = '';
    }

    // 7. Notifikasi Toast
    function tampilkanToast(pesan) {
      const toast = document.getElementById('toastPopUp');
      const teks = document.getElementById('toastTeks');
      teks.textContent = pesan;
      toast.style.display = 'flex';

      setTimeout(() => {
        toast.style.display = 'none';
      }, 4500);
    }
  </script>
