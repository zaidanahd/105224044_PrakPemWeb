<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>BantuBelajar - Solusi Tutor Sabar & Berpengalaman</title>
  <meta name="description" content="Temukan guru les dan tutor berpengalaman yang sabar mendampingi siswa yang kesulitan belajar. Tampilan modern, sederhana, dan mudah dipahami orang awam.">

  <style>
    /* ==========================================================
       MODERN BLUE GRADIENT THEME & DESIGN SYSTEM
       Sederhana, bersih, modern, dan sangat nyaman untuk orang awam
       ========================================================== */
    :root {
      /* Gradien Biru Utama */
      --grad-primary: linear-gradient(135deg, #1e40af 0%, #2563eb 50%, #0284c7 100%);
      --grad-primary-hover: linear-gradient(135deg, #1e3a8a 0%, #1d4ed8 50%, #0369a1 100%);
      --grad-hero: linear-gradient(180deg, #dbeafe 0%, #eff6ff 45%, #f8fafc 100%);
      --grad-banner: linear-gradient(135deg, #0f172a 0%, #1e3a8a 50%, #2563eb 100%);
      --grad-card-header: linear-gradient(135deg, #eff6ff 0%, #e0f2fe 100%);
      --grad-accent: linear-gradient(135deg, #0ea5e9 0%, #38bdf8 100%);
      --grad-badge: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%);

      /* Warna Padat */
      --blue-deep: #1e3a8a;
      --blue-primary: #2563eb;
      --blue-light: #60a5fa;
      --blue-subtle: #f0f7ff;
      --teal-accent: #0284c7;

      --text-dark: #0f172a;       /* Kontras tinggi agar mudah dibaca */
      --text-muted: #334155;      /* Abu-abu tua jelas */
      --text-light: #64748b;
      --bg-page: #f8fafc;
      --bg-card: #ffffff;
      --border-card: #e2e8f0;
      --border-blue: #bfdbfe;

      /* Bayangan Halus Modern (Blue Tint Shadow) */
      --shadow-sm: 0 2px 6px rgba(37, 99, 235, 0.06);
      --shadow-md: 0 8px 20px rgba(37, 99, 235, 0.08);
      --shadow-lg: 0 16px 36px rgba(37, 99, 235, 0.14);
      --shadow-glow: 0 0 20px rgba(56, 189, 248, 0.35);

      --radius-sm: 10px;
      --radius-md: 16px;
      --radius-lg: 24px;
      --radius-full: 9999px;
      --font-base: 18px;          /* Ukuran teks default ramah mata */
    }

    /* Mode Perbesar Tulisan untuk Orang Tua / Penglihatan Kurang Awas */
    body.teks-besar {
      --font-base: 21px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      font-size: var(--font-base);
      line-height: 1.65;
      color: var(--text-dark);
      background-color: var(--bg-page);
      -webkit-font-smoothing: antialiased;
    }

    a {
      color: var(--blue-primary);
      text-decoration: none;
      transition: color 0.2s;
    }

    a:hover {
      text-decoration: underline;
    }

    .container {
      width: 100%;
      max-width: 1140px;
      margin: 0 auto;
      padding: 0 20px;
    }

    /* ==========================================================
       BAR BANTUAN CEPAT (GRADIENT PALING ATAS)
       ========================================================== */
    .top-bar-modern {
      background: linear-gradient(90deg, #0f172a 0%, #1e3a8a 100%);
      color: #ffffff;
      padding: 12px 0;
      font-size: 0.95rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .top-bar-content {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
    }

    .top-bar-left {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
      font-weight: 500;
    }

    .pill-call-free {
      background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
      color: #ffffff;
      padding: 4px 14px;
      border-radius: var(--radius-full);
      font-weight: 800;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      box-shadow: 0 2px 8px rgba(34, 197, 94, 0.35);
      text-decoration: none;
    }

    .pill-call-free:hover {
      background: #15803d;
      text-decoration: none;
    }

    .btn-font-toggle {
      background: rgba(255, 255, 255, 0.16);
      border: 1px solid rgba(255, 255, 255, 0.3);
      color: #ffffff;
      padding: 5px 14px;
      border-radius: var(--radius-full);
      font-size: 0.9rem;
      cursor: pointer;
      font-weight: 600;
      transition: background 0.2s;
    }

    .btn-font-toggle:hover {
      background: rgba(255, 255, 255, 0.28);
    }

    /* ==========================================================
       HEADER & NAVIGASI BERGAYA GLASS & GRADIENT
       ========================================================== */
    header {
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(8px);
      border-bottom: 2px solid var(--border-blue);
      position: sticky;
      top: 0;
      z-index: 100;
      box-shadow: var(--shadow-sm);
    }

    .navbar-inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 16px 0;
    }

    .logo-brand {
      display: flex;
      align-items: center;
      gap: 14px;
      text-decoration: none;
    }

    .logo-badge-icon {
      width: 52px;
      height: 52px;
      background: var(--grad-primary);
      color: #ffffff;
      border-radius: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 4px 14px rgba(37, 99, 235, 0.35);
      transform: rotate(-2deg);
    }

    .logo-label h1 {
      font-size: 1.65rem;
      font-weight: 900;
      color: #0f172a;
      line-height: 1.1;
      letter-spacing: -0.5px;
    }

    .logo-label h1 span {
      background: var(--grad-primary);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .logo-label p {
      font-size: 0.88rem;
      color: var(--text-muted);
      font-weight: 600;
    }

    .nav-list {
      display: flex;
      align-items: center;
      list-style: none;
      gap: 18px;
    }

    .nav-item-link {
      font-size: 1.05rem;
      font-weight: 700;
      color: #1e293b;
      padding: 8px 14px;
      border-radius: var(--radius-sm);
      transition: all 0.2s;
    }

    .nav-item-link:hover {
      background: var(--blue-subtle);
      color: var(--blue-primary);
      text-decoration: none;
    }

    .btn-nav-gradient {
      background: var(--grad-primary);
      color: #ffffff !important;
      font-weight: 800;
      padding: 12px 24px;
      border-radius: var(--radius-full);
      box-shadow: 0 4px 15px rgba(37, 99, 235, 0.3);
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: transform 0.2s, box-shadow 0.2s;
    }

    .btn-nav-gradient:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(37, 99, 235, 0.4);
      text-decoration: none;
    }

    /* ==========================================================
       HERO SECTION DENGAN GRADASI BIRU SEGAR
       ========================================================== */
    .hero-wrapper {
      background: var(--grad-hero);
      padding: 70px 0 55px;
      position: relative;
      border-bottom: 1px solid var(--border-blue);
    }

    .hero-layout {
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      gap: 40px;
      align-items: center;
    }

    .badge-modern-pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: #ffffff;
      color: #1e40af;
      padding: 8px 18px;
      border-radius: var(--radius-full);
      font-weight: 800;
      font-size: 0.95rem;
      margin-bottom: 22px;
      border: 2px solid #bfdbfe;
      box-shadow: var(--shadow-sm);
    }

    .hero-main-title {
      font-size: 2.85rem;
      font-weight: 900;
      color: #0f172a;
      line-height: 1.25;
      margin-bottom: 20px;
      letter-spacing: -0.5px;
    }

    .gradient-text-blue {
      background: var(--grad-primary);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      display: inline-block;
    }

    .hero-paragraph {
      font-size: 1.25rem;
      color: var(--text-muted);
      line-height: 1.65;
      margin-bottom: 28px;
    }

    .hero-point-list {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .point-item {
      display: flex;
      align-items: center;
      gap: 12px;
      font-size: 1.1rem;
      font-weight: 700;
      color: #1e293b;
    }

    .point-icon {
      width: 28px;
      height: 28px;
      background: var(--grad-primary);
      color: #ffffff;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 900;
      font-size: 0.9rem;
      flex-shrink: 0;
    }

    /* KOTAK PENCARIAN MODERN (3 KLIK MUDAH) */
    .search-card-modern {
      background: #ffffff;
      border: 3px solid var(--border-blue);
      border-radius: var(--radius-lg);
      padding: 34px;
      box-shadow: var(--shadow-lg);
      position: relative;
    }

    .search-card-modern::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 6px;
      background: var(--grad-primary);
      border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    }

    .search-card-header {
      text-align: center;
      margin-bottom: 24px;
    }

    .search-card-header h2 {
      font-size: 1.65rem;
      font-weight: 900;
      color: #0f172a;
      margin-bottom: 6px;
    }

    .search-card-header p {
      font-size: 1.05rem;
      color: var(--text-muted);
    }

    .form-stack {
      display: flex;
      flex-direction: column;
      gap: 18px;
    }

    .input-group-modern {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .input-group-modern label {
      font-size: 1.05rem;
      font-weight: 800;
      color: #1e293b;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .select-modern {
      height: 54px;
      padding: 0 16px;
      border: 2px solid #cbd5e1;
      border-radius: var(--radius-md);
      font-size: 1.1rem;
      font-weight: 600;
      color: #0f172a;
      background-color: #f8fafc;
      transition: all 0.2s;
    }

    .select-modern:focus {
      outline: none;
      border-color: var(--blue-primary);
      background-color: #ffffff;
      box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.15);
    }

    .btn-gradient-search {
      height: 58px;
      background: var(--grad-primary);
      color: #ffffff;
      border: none;
      border-radius: var(--radius-md);
      font-size: 1.25rem;
      font-weight: 900;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      box-shadow: 0 6px 18px rgba(37, 99, 235, 0.35);
      margin-top: 10px;
      transition: all 0.2s;
    }

    .btn-gradient-search:hover {
      background: var(--grad-primary-hover);
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(37, 99, 235, 0.45);
    }

    .search-helper-footer {
      text-align: center;
      font-size: 0.95rem;
      color: var(--text-muted);
      margin-top: 16px;
    }

    .search-helper-footer a {
      font-weight: 800;
      color: var(--blue-deep);
    }

    /* ==========================================================
       CARA KERJA 3 LANGKAH DENGAN LINGKARAN GRADASI
       ========================================================== */
    .section-padding {
      padding: 75px 0;
    }

    .section-heading-box {
      text-align: center;
      max-width: 740px;
      margin: 0 auto 50px;
    }

    .pill-section-tag {
      display: inline-block;
      background: var(--grad-badge);
      color: #1e3a8a;
      padding: 6px 18px;
      border-radius: var(--radius-full);
      font-size: 0.95rem;
      font-weight: 800;
      margin-bottom: 12px;
      border: 1px solid #93c5fd;
    }

    .section-title-large {
      font-size: 2.35rem;
      font-weight: 900;
      color: #0f172a;
      line-height: 1.3;
      margin-bottom: 12px;
    }

    .section-subtitle-text {
      font-size: 1.2rem;
      color: var(--text-muted);
    }

    .steps-grid-modern {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 30px;
    }

    .step-card-modern {
      background: #ffffff;
      border: 2px solid var(--border-blue);
      border-radius: var(--radius-lg);
      padding: 36px 24px;
      text-align: center;
      box-shadow: var(--shadow-sm);
      transition: transform 0.2s, box-shadow 0.2s;
      position: relative;
    }

    .step-card-modern:hover {
      transform: translateY(-5px);
      box-shadow: var(--shadow-md);
      border-color: #60a5fa;
    }

    .step-number-circle {
      width: 64px;
      height: 64px;
      background: var(--grad-primary);
      color: #ffffff;
      border-radius: 50%;
      font-size: 1.75rem;
      font-weight: 900;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 22px;
      box-shadow: 0 6px 16px rgba(37, 99, 235, 0.35);
    }

    .step-card-modern h3 {
      font-size: 1.45rem;
      font-weight: 900;
      color: #0f172a;
      margin-bottom: 12px;
    }

    .step-card-modern p {
      font-size: 1.1rem;
      color: var(--text-muted);
      line-height: 1.6;
    }

    /* ==========================================================
       DAFTAR TUTOR BERPENGALAMAN & KARTU MODERN
       ========================================================== */
    .tutor-section-modern {
      background: #ffffff;
      border-top: 2px solid var(--border-blue);
      border-bottom: 2px solid var(--border-blue);
    }

    /* Filter Pills */
    .filter-row-modern {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 12px;
      margin-bottom: 42px;
    }

    .filter-btn-pill {
      background: #f1f5f9;
      border: 2px solid #cbd5e1;
      padding: 12px 24px;
      border-radius: var(--radius-full);
      font-size: 1.05rem;
      font-weight: 800;
      color: #334155;
      cursor: pointer;
      transition: all 0.2s;
    }

    .filter-btn-pill:hover {
      background: #e2e8f0;
      border-color: #94a3b8;
    }

    .filter-btn-pill.active {
      background: var(--grad-primary);
      border-color: transparent;
      color: #ffffff;
      box-shadow: 0 4px 15px rgba(37, 99, 235, 0.35);
    }

    /* Grid Kartu Tutor */
    .tutors-modern-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(330px, 1fr));
      gap: 30px;
    }

    .tutor-card-clean {
      background: #ffffff;
      border: 2px solid var(--border-blue);
      border-radius: var(--radius-lg);
      padding: 26px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      box-shadow: var(--shadow-sm);
      transition: all 0.25s ease;
      position: relative;
    }

    .tutor-card-clean:hover {
      transform: translateY(-5px);
      border-color: #3b82f6;
      box-shadow: var(--shadow-lg);
    }

    .tutor-head-flex {
      display: flex;
      gap: 18px;
      margin-bottom: 16px;
    }

    .tutor-avatar-img {
      width: 78px;
      height: 78px;
      border-radius: 50%;
      object-fit: cover;
      border: 3px solid #60a5fa;
      background: #dbeafe;
      flex-shrink: 0;
      box-shadow: 0 4px 10px rgba(37, 99, 235, 0.2);
    }

    .tutor-info-meta h3 {
      font-size: 1.35rem;
      font-weight: 900;
      color: #0f172a;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .badge-terverifikasi {
      background: linear-gradient(135deg, #dcfce7 0%, #bbf7d0 100%);
      color: #166534;
      font-size: 0.8rem;
      font-weight: 800;
      padding: 3px 10px;
      border-radius: var(--radius-full);
      display: inline-block;
      border: 1px solid #86efac;
    }

    .tutor-experience-txt {
      font-size: 0.95rem;
      color: #1e40af;
      font-weight: 700;
      margin-top: 3px;
    }

    .tutor-rating-flex {
      display: flex;
      align-items: center;
      gap: 6px;
      margin-top: 4px;
      font-size: 0.95rem;
    }

    .stars-icon {
      color: #eab308;
      font-weight: 900;
      font-size: 1.1rem;
    }

    .score-txt {
      font-weight: 800;
      color: #0f172a;
    }

    .count-txt {
      color: #64748b;
      font-size: 0.9rem;
    }

    /* Tag Keahlian */
    .tutor-tags-container {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 16px;
    }

    .tag-blue-soft {
      background: #eff6ff;
      color: #1d4ed8;
      font-size: 0.9rem;
      font-weight: 700;
      padding: 5px 12px;
      border-radius: var(--radius-sm);
      border: 1px solid #bfdbfe;
    }

    .tag-yellow-soft {
      background: #fefce8;
      color: #a16207;
      font-size: 0.9rem;
      font-weight: 700;
      padding: 5px 12px;
      border-radius: var(--radius-sm);
      border: 1px solid #fef08a;
    }

    .tutor-quote-gradient {
      background: linear-gradient(180deg, #f8fafc 0%, #eff6ff 100%);
      border-left: 4px solid var(--blue-primary);
      padding: 14px 16px;
      border-radius: var(--radius-sm);
      font-size: 1.05rem;
      color: #1e293b;
      line-height: 1.55;
      margin-bottom: 20px;
      font-style: italic;
    }

    .tutor-footer-action {
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-top: 2px solid #f1f5f9;
      padding-top: 18px;
      margin-top: auto;
    }

    .rate-label-box {
      display: flex;
      flex-direction: column;
    }

    .rate-small {
      font-size: 0.85rem;
      color: #64748b;
      font-weight: 700;
      text-transform: uppercase;
    }

    .rate-price {
      font-size: 1.3rem;
      font-weight: 900;
      color: #0f172a;
    }

    .btn-card-trial {
      background: var(--grad-primary);
      color: #ffffff;
      border: none;
      padding: 12px 22px;
      border-radius: var(--radius-full);
      font-size: 1rem;
      font-weight: 800;
      cursor: pointer;
      box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);
      transition: all 0.2s;
    }

    .btn-card-trial:hover {
      background: var(--grad-primary-hover);
      transform: translateY(-2px);
      box-shadow: 0 6px 16px rgba(37, 99, 235, 0.35);
    }

    /* ==========================================================
       BANNER EMPATI GRADASI BIRU TUA
       ========================================================== */
    .banner-gradient-empati {
      background: var(--grad-banner);
      color: #ffffff;
      border-radius: var(--radius-lg);
      padding: 45px 40px;
      margin-top: 60px;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 30px;
      box-shadow: var(--shadow-lg);
      border: 1px solid rgba(255, 255, 255, 0.15);
    }

    .empati-text-area {
      max-width: 660px;
    }

    .empati-text-area h3 {
      font-size: 2.1rem;
      font-weight: 900;
      margin-bottom: 14px;
      color: #ffffff;
    }

    .empati-text-area p {
      font-size: 1.2rem;
      color: #e2e8f0;
      line-height: 1.65;
    }

    .empati-button-area {
      display: flex;
      flex-direction: column;
      gap: 10px;
      min-width: 270px;
    }

    .btn-wa-gradient {
      background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
      color: #ffffff !important;
      font-size: 1.2rem;
      font-weight: 900;
      padding: 16px 24px;
      border-radius: var(--radius-md);
      text-align: center;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      box-shadow: 0 6px 18px rgba(34, 197, 94, 0.4);
      text-decoration: none;
      transition: all 0.2s;
    }

    .btn-wa-gradient:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 22px rgba(34, 197, 94, 0.5);
      text-decoration: none;
    }

    /* ==========================================================
       TESTIMONI BERSIH & MODERN
       ========================================================== */
    .testimonial-modern-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 26px;
    }

    .testimoni-card-clean {
      background: #ffffff;
      border: 2px solid var(--border-blue);
      border-radius: var(--radius-md);
      padding: 30px;
      box-shadow: var(--shadow-sm);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      position: relative;
    }

    .testimoni-card-clean::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 4px;
      background: var(--grad-primary);
      border-radius: var(--radius-md) var(--radius-md) 0 0;
    }

    .quote-content {
      font-size: 1.1rem;
      color: #1e293b;
      line-height: 1.65;
      margin-bottom: 22px;
      font-style: italic;
    }

    .author-modern {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .author-badge-circle {
      width: 52px;
      height: 52px;
      background: var(--grad-badge);
      color: #1e40af;
      font-weight: 900;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.15rem;
